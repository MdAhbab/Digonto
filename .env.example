# Copy to .env and fill in. run.py does this for you and generates the secrets.
# Never commit .env. Never paste a real key into a chat, an issue, or a commit.

APP_ENV=development
APP_NAME=Digonto
API_BASE_PATH=/api/v1
PUBLIC_BASE_URL=http://localhost:5173
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Leave these empty. run.py generates a fresh value per machine.
# In production they must be set explicitly, or the app refuses to start.
JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
VAULT_MASTER_KEY=

DB_DIR=./data/db
VAULT_DIR=./data/vault
SNAPSHOT_DIR=./data/snapshots
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333

OLLAMA_BASE_URL=http://localhost:11434
GEMMA_MODEL=gemma4:e2b
EMBED_MODEL=bge-m3
OLLAMA_KEEP_ALIVE=30m

# Seed accounts, created only when APP_ENV is not production.
SEED_JUDGE_EMAIL=judge@digonto.ahbab.dev
SEED_JUDGE_PASSWORD=change-me
SEED_MODERATOR_EMAIL=moderator@digonto.ahbab.dev
SEED_MODERATOR_PASSWORD=change-me
SEED_DEMO_DATA=true

# --- Model routing ----------------------------------------------------------
# Two paths, split by what the call is for. See TaskKind in app/llm/router.py.
#
# CORE is the product: grounded answering, change classification, all seven agents,
# vision extraction over uploaded documents, interview and eligibility scoring. Gemma 4
# E2B does all of it, locally, and this must stay `gemma`. Setting it to `gemini` would
# send a student's document text to a third party, which the router refuses anyway:
# `contains_user_documents` and `images` force the local provider regardless of config.
#
# FAST is preprocessing and chrome: query normalisation, Banglish transliteration,
# conversation titles, follow-up suggestions, short summaries. Ollama serves one request
# at a time (OLLAMA_NUM_PARALLEL=1), and a grounded answer occupies that slot for tens of
# seconds. Queueing a 40-token title behind it delays the answer the student is waiting
# for. Routing the fast path to the hosted model keeps the single local slot on the work
# that must be local.
#
# Either way the remote side is bounded: per-model request ceilings cap it, no document
# content can reach it, and with no GEMINI_API_KEY set both paths fall back to `gemma` so
# the system still runs entirely offline.
FAST_PATH_PROVIDER=gemini
CORE_PATH_PROVIDER=gemma
FALLBACK_ENABLED=true

# Remote models are an ordered chain, tried in turn until one has capacity, then the local
# model. Entries are `name:requests_per_minute:requests_per_day`. The shipped default in
# backend/app/config.py holds the current free-tier limits; set this only to override it.
# FALLBACK_MODELS=gemini-3.6-flash:5:20,gemini-3.5-flash-lite:15:500

# Applied to a chain entry that does not carry its own two limits.
FALLBACK_MAX_RPM=5
FALLBACK_DAILY_BUDGET=20
